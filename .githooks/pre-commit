#!/bin/sh
# Check any post being committed. Skip with `git commit --no-verify`.
root=$(git rev-parse --show-toplevel)
posts=$(git diff --cached --name-only --diff-filter=ACM | grep '^src/data/post/.*\.md$' || true)
[ -z "$posts" ] && exit 0
# shellcheck disable=SC2086
python3 "$root/scripts/check_posts.py" $posts
